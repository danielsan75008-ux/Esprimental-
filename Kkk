local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "CoiledTom V3 INSANO 😈",
    Size = UDim2.new(0, 620, 0, 420),
    Theme = "Dark"
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

local Troll = Window:CreateTab("Troll/Useful")
local Scripts = Window:CreateTab("Scripts")
local PlayerTab = Window:CreateTab("Player")
local Combat = Window:CreateTab("Combat")
local Settings = Window:CreateTab("Settings")

-- FOV Circle
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Thickness = 2
fovCircle.NumSides = 100
fovCircle.Radius = 120
fovCircle.Color = Color3.fromRGB(255,0,0)
fovCircle.Filled = false

RunService.RenderStepped:Connect(function()
    fovCircle.Position = UIS:GetMouseLocation()
end)
local aimbot = false
local fov = 120
local smooth = 0.2
local teamCheck = false

Combat:CreateToggle({Name="Aimbot",Callback=function(v) aimbot=v end})
Combat:CreateToggle({Name="Team Check",Callback=function(v) teamCheck=v end})
Combat:CreateToggle({Name="Show FOV",Callback=function(v) fovCircle.Visible=v end})

Combat:CreateSlider({Name="FOV",Min=50,Max=300,Callback=function(v)
    fov=v
    fovCircle.Radius=v
end})

Combat:CreateSlider({Name="Smooth",Min=1,Max=10,Callback=function(v)
    smooth=v/50
end})

RunService.RenderStepped:Connect(function()
    if aimbot then
        local closest,dist=nil,fov
        for _,p in pairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                if teamCheck and p.Team == LocalPlayer.Team then continue end
                
                local pos,_=Camera:WorldToViewportPoint(p.Character.Head.Position)
                local mag=(Vector2.new(pos.X,pos.Y)-UIS:GetMouseLocation()).Magnitude
                
                if mag<dist then
                    closest=p
                    dist=mag
                end
            end
        end
        
        if closest then
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.new(Camera.CFrame.Position, closest.Character.Head.Position),
                smooth
            )
        end
    end
end)
local esp=false
local espColor=Color3.fromRGB(255,0,0)
local showName=true
local showDistance=true

Combat:CreateToggle({Name="ESP",Callback=function(v) esp=v end})
Combat:CreateColorPicker({Name="ESP Color",Callback=function(c) espColor=c end})
Combat:CreateToggle({Name="Show Name",Callback=function(v) showName=v end})
Combat:CreateToggle({Name="Show Distance",Callback=function(v) showDistance=v end})

RunService.Heartbeat:Connect(function()
    if esp then
        for _,p in pairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then
                if not p.Character:FindFirstChild("Highlight") then
                    local h=Instance.new("Highlight",p.Character)
                    h.FillColor=espColor
                end
                
                if showName then
                    local head=p.Character:FindFirstChild("Head")
                    if head and not head:FindFirstChild("BillboardGui") then
                        local gui=Instance.new("BillboardGui",head)
                        gui.Size=UDim2.new(0,100,0,40)
                        gui.AlwaysOnTop=true
                        
                        local txt=Instance.new("TextLabel",gui)
                        txt.Size=UDim2.new(1,0,1,0)
                        txt.BackgroundTransparency=1
                        txt.TextColor3=espColor
                        txt.Text=p.Name
                    end
                end
            end
        end
    end
end)
-- Hitbox
local hit=false
local size=5
local trans=0.5

Combat:CreateToggle({Name="Hitbox",Callback=function(v) hit=v end})
Combat:CreateSlider({Name="Size",Min=2,Max=20,Callback=function(v) size=v end})
Combat:CreateSlider({Name="Transparency",Min=0,Max=1,Callback=function(v) trans=v end})

RunService.Heartbeat:Connect(function()
    if hit then
        for _,p in pairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then
                local h=p.Character:FindFirstChild("Head")
                if h then
                    h.Size=Vector3.new(size,size,size)
                    h.Transparency=trans
                end
            end
        end
    end
end)

