Btn.Draggable = true

--// WINDOW
local Window = WindUI:CreateWindow({
    Title = "CoiledTom V2 😈",
    Size = UDim2.fromOffset(500,400)
})

Window:Toggle(false)

Btn.MouseButton1Click:Connect(function()
    Window:Toggle()
